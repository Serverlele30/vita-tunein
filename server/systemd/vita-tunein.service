[Unit]
Description=PS-Vita-TuneIn-Adapter (tin.serverlele.de)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/vita-tunein/adapter.py
Restart=always
RestartSec=2
Environment=PYTHONUNBUFFERED=1
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
